# Step 1: Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Set styles
plt.style.use('seaborn-v0_8-darkgrid')  # recommended
sns.set_palette("viridis")

# Step 2: Load Dataset (use the Olist dataset from Kaggle)
orders = pd.read_csv("D:/project/Analysis/olist_orders_dataset.csv")
order_items = pd.read_csv("D:/project/Analysis/olist_order_items_dataset.csv")
customers = pd.read_csv("D:/project/Analysis/olist_customers_dataset.csv")
products = pd.read_csv("D:/project/Analysis/olist_products_dataset.csv")
payments = pd.read_csv("D:/project/Analysis/olist_order_payments_dataset.csv")
reviews = pd.read_csv("D:/project/Analysis/olist_order_reviews_dataset.csv")

# Step 3: Quick Overview
print("Orders dataset shape:", orders.shape)
print("Order items dataset shape:", order_items.shape)
print("Payments dataset shape:", payments.shape)
print("Customers dataset shape:", customers.shape)

# Check missing values
print("\nMissing values:\n", orders.isnull().sum())

# Step 4: Data Preprocessing
# Convert date columns
date_cols = ['order_purchase_timestamp','order_approved_at',
             'order_delivered_carrier_date','order_delivered_customer_date',
             'order_estimated_delivery_date']

for col in date_cols:
    orders[col] = pd.to_datetime(orders[col])

# Merge datasets for analysis
order_data = (orders.merge(order_items, on="order_id")
                     .merge(payments, on="order_id")
                     .merge(customers, on="customer_id"))

# Step 5: Sales Trend Analysis
# Revenue per month
order_data['order_month'] = order_data['order_purchase_timestamp'].dt.to_period('M')
monthly_sales = order_data.groupby('order_month')['payment_value'].sum()

plt.figure(figsize=(12,6))
monthly_sales.plot(kind='line', marker='o')
plt.title("Monthly Revenue Trend")
plt.ylabel("Revenue (BRL)")
plt.xlabel("Month")
plt.show()

# Step 6: Top Categories by Sales
order_data = order_data.merge(products, on="product_id")
category_sales = order_data.groupby('product_category_name')['payment_value'].sum().sort_values(ascending=False).head(10)

plt.figure(figsize=(10,6))
sns.barplot(x=category_sales.values, y=category_sales.index)
plt.title("Top 10 Product Categories by Revenue")
plt.xlabel("Revenue (BRL)")
plt.ylabel("Category")
plt.show()

# Step 7: Customer Insights
# New vs Returning Customers
customer_orders = orders.groupby('customer_id')['order_purchase_timestamp'].min().reset_index()
customer_orders['first_purchase_month'] = customer_orders['order_purchase_timestamp'].dt.to_period('M')

order_data['first_purchase_month'] = order_data['customer_id'].map(
    dict(zip(customer_orders['customer_id'], customer_orders['first_purchase_month']))
)

order_data['is_new_customer'] = order_data['order_purchase_timestamp'].dt.to_period('M') == order_data['first_purchase_month']

customer_split = order_data.groupby('is_new_customer')['customer_id'].nunique()

plt.figure(figsize=(6,6))
customer_split.plot(kind='pie', autopct='%1.1f%%', labels=['Returning','New'], startangle=90, colors=['#4daf4a','#377eb8'])
plt.title("New vs Returning Customers")
plt.show()

# Step 8: Payment Method Breakdown
payment_types = payments.groupby('payment_type')['payment_value'].sum().sort_values(ascending=False)

plt.figure(figsize=(8,6))
sns.barplot(x=payment_types.values, y=payment_types.index)
plt.title("Payment Methods by Revenue")
plt.xlabel("Revenue (BRL)")
plt.ylabel("Payment Type")
plt.show()

# Step 9: Delivery Performance
delivery_time = (orders['order_delivered_customer_date'] - orders['order_purchase_timestamp']).dt.days
plt.figure(figsize=(10,6))
sns.histplot(delivery_time.dropna(), bins=30, kde=True)
plt.title("Delivery Time Distribution (days)")
plt.xlabel("Days to Deliver")
plt.ylabel("Number of Orders")
plt.show()

# Step 10: Review Score Analysis
review_score = reviews['review_score'].value_counts(normalize=True) * 100
plt.figure(figsize=(8,6))
sns.barplot(x=review_score.index, y=review_score.values)
plt.title("Customer Review Score Distribution")
plt.xlabel("Review Score")
plt.ylabel("Percentage (%)")
plt.show()

print("\n✅ Analysis Completed!")
